{
  "name": "remote-podrelay",
  "displayName": "Remote - PodRelay",
  "description": "Open any folder in a Kubernetes pod through podrelay, with the full VS Code feature set",
  "version": "0.2.0",
  "publisher": "fqix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fqix/podrelay.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kubernetes",
    "ssh",
    "remote",
    "pod"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "resolvers"
  ],
  "activationEvents": [
    "onResolveRemoteAuthority:podrelay"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "podrelay.connect",
        "title": "Connect to Pod...",
        "category": "Remote-PodRelay"
      },
      {
        "command": "podrelay.connectCurrentWindow",
        "title": "Connect Current Window to Pod...",
        "category": "Remote-PodRelay"
      },
      {
        "command": "podrelay.showLog",
        "title": "Show Log",
        "category": "Remote-PodRelay"
      }
    ],
    "configuration": {
      "title": "Remote - PodRelay",
      "properties": {
        "podrelay.relayUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Relay base URL: wss://relay.example.com, or ws:// for local testing"
        },
        "podrelay.connectTo": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Dial this host:port instead of resolving the relay host (Host header and TLS name stay the same), like curl --connect-to."
        },
        "podrelay.identityFile": {
          "type": "string",
          "default": "~/.ssh/id_ed25519",
          "scope": "application",
          "description": "SSH private key used for the relay and for sshd. If it is passphrase-protected, the matching key in ssh-agent is used."
        },
        "podrelay.user": {
          "type": "string",
          "default": "root",
          "scope": "application",
          "description": "Login user inside the pod."
        },
        "podrelay.serverDownloadUrlTemplate": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Override where the VS Code server is downloaded from. Variables: ${commit} ${quality} ${version} ${release} ${os} ${arch} ${platform}. Defaults to the editor's product.json template, or Microsoft's update server."
        }
      }
    },
    "menus": {
      "statusBar/remoteIndicator": [
        {
          "command": "podrelay.connect",
          "group": "remote_30_podrelay_1_general@1"
        },
        {
          "command": "podrelay.connectCurrentWindow",
          "group": "remote_30_podrelay_1_general@2"
        },
        {
          "command": "podrelay.showLog",
          "group": "remote_30_podrelay_1_general@3",
          "when": "remoteName == podrelay"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/extension.js --external:vscode --external:cpu-features --external:./crypto/build/Release/sshcrypto.node --minify --sourcemap",
    "build:e2e": "esbuild test/e2e.ts --bundle --platform=node --target=node20 --outfile=dist/e2e.js --external:cpu-features --external:./crypto/build/Release/sshcrypto.node",
    "typecheck": "tsc -p .",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
